{
  "name": "unreal-project-tools",
  "displayName": "Unreal Engine Auto Setup (Alpha)",
  "description": "Unreal project setup, safe build automation, Editor controls, C++ generation and module dependency tools for VS Code.",
  "version": "1.0.0",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Extension Packs"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Writes project configuration and activates UnrealBuildTool integration only in trusted folders."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "snippets": [{ "language": "cpp", "path": "./snippets/unreal.json" }],
    "commands": [
      {
        "command": "unrealSetup.setup",
        "title": "Unreal: Set Up This Project"
      },
      {
        "command": "unrealSetup.build",
        "title": "Unreal: Build Project"
      },
      {
        "command": "unrealSetup.buildAndRun",
        "title": "Unreal: Build and Open Editor"
      },
      {
        "command": "unrealSetup.installExtensions",
        "title": "Unreal: Install Required Extensions"
      },
      {
        "command": "unrealSetup.openEditor",
        "title": "Unreal: Open Editor"
      },
      {
        "command": "unrealSetup.selectTarget",
        "title": "Unreal: Select Target"
      },
      {
        "command": "unrealSetup.selectPlatform",
        "title": "Unreal: Select Platform"
      },
      {
        "command": "unrealSetup.selectConfiguration",
        "title": "Unreal: Select Configuration"
      },
      {
        "command": "unrealSetup.selectBuild",
        "title": "Unreal: Select Build Settings"
      },
      {
        "command": "unrealSetup.diagnose",
        "title": "Unreal: Diagnose Project"
      },
      {
        "command": "unrealSetup.openLatestLog",
        "title": "Unreal: Open Latest Project Log"
      },
      {
        "command": "unrealSetup.attachDebugger",
        "title": "Unreal: Attach Debugger to Editor"
      },
      {
        "command": "unrealSetup.regenerate",
        "title": "Unreal: Regenerate Project Files"
      },
      {
        "command": "unrealSetup.newClass",
        "title": "Unreal: New C++ Class"
      },
      {
        "command": "unrealSetup.openModuleRules",
        "title": "Unreal: Open Module Build.cs"
      },
      {
        "command": "unrealSetup.openProjectDescriptor",
        "title": "Unreal: Open Project Descriptor"
      },
      {
        "command": "unrealSetup.openTargetRules",
        "title": "Unreal: Open Target Rules"
      },
      {
        "command": "unrealSetup.newModule",
        "title": "Unreal: New Module"
      },
      {
        "command": "unrealSetup.newPlugin",
        "title": "Unreal: New Plugin"
      },
      {
        "command": "unrealSetup.openPluginDescriptor",
        "title": "Unreal: Open Plugin Descriptor"
      },
      {
        "command": "unrealSetup.run",
        "title": "Unreal: Run"
      },
      {
        "command": "unrealSetup.refresh",
        "title": "Unreal: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "unrealSetup.createClassHere",
        "title": "Unreal: Create Class Here"
      },
      {
        "command": "unrealSetup.inspectDependencies",
        "title": "Unreal: Inspect Module Dependencies"
      },
      {
        "command": "unrealSetup.addDependency",
        "title": "Unreal: Add Module Dependency"
      },
      {
        "command": "unrealSetup.removeDependency",
        "title": "Unreal: Remove Module Dependency"
      },
      {
        "command": "unrealSetup.changeDependencyVisibility",
        "title": "Unreal: Change Dependency Visibility"
      },
      {
        "command": "unrealSetup.findModuleForInclude",
        "title": "Unreal: Find Module for Include"
      },
      {
        "command": "unrealSetup.refreshDependencyIndex",
        "title": "Unreal: Refresh Dependency Index"
      },
      {
        "command": "unrealSetup.manageDependencies",
        "title": "Unreal: Manage Module Dependencies"
      },
      {
        "command": "unrealSetup.automationMode",
        "title": "Set Automation Mode",
        "category": "Unreal"
      },
      {
        "command": "unrealSetup.autoBuildDelay",
        "title": "Set Auto Build Delay",
        "category": "Unreal"
      },
      {
        "command": "unrealSetup.runtimeInterval",
        "title": "Set Runtime Refresh Interval",
        "category": "Unreal"
      },
      {
        "command": "unrealSetup.cancelPendingAutomaticBuild",
        "title": "Cancel Pending Automatic Build",
        "category": "Unreal"
      },
      {
        "command": "unrealSetup.cancelBuild",
        "title": "Cancel Build",
        "category": "Unreal"
      }
    ],
    "configuration": {
      "title": "Unreal Engine Auto Setup",
      "properties": {
        "unrealSetup.autoSetup": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically initialize local Unreal project folders."
        },
        "unrealSetup.runtimeRefreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "description": "Runtime reconciliation interval in seconds: 0 disables polling; use 10–3600. Invalid values fall back to 30. Checks pending changes; never an unconditional build timer."
        },
        "unrealSetup.automationMode": {
          "type": "string",
          "enum": [
            "off",
            "watch",
            "autoBuild",
            "autoBuildAndRegenerate"
          ],
          "enumDescriptions": [
            "No automatic work",
            "Track changes without compiling (recommended)",
            "Build saved source after debounce; stale structure blocks builds",
            "Regenerate stale structure, then build after debounce"
          ],
          "default": "watch",
          "scope": "resource",
          "description": "Project automation mode. Compilation is opt-in."
        },
        "unrealSetup.autoBuildDelay": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "scope": "resource",
          "description": "Seconds after the last relevant saved change before automatic work."
        },
        "unrealSetup.verboseRuntimeLogging": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Log runtime reconciliation details."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unrealSetup",
          "title": "Unreal",
          "icon": "media/unreal.svg"
        }
      ]
    },
    "views": {
      "unrealSetup": [
        {
          "id": "unrealSetup.controlCenter",
          "name": "Unreal",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "unrealSetup.refresh",
          "when": "view == unrealSetup.controlCenter",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "unrealSetup.createClassHere",
          "when": "unrealSetup.projectActive && isWorkspaceTrusted && explorerResourceIsFolder && resourcePath in unrealSetup.classFolders",
          "group": "unreal@1"
        },
        {
          "command": "unrealSetup.manageDependencies",
          "when": "unrealSetup.projectActive && isWorkspaceTrusted && resourcePath in unrealSetup.moduleRules",
          "group": "unreal@2"
        }
      ],
      "editor/context": [
        {
          "command": "unrealSetup.findModuleForInclude",
          "when": "unrealSetup.projectActive && isWorkspaceTrusted && editorLangId == cpp && unrealSetup.includeContext",
          "group": "unreal@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "unrealSetup.newClass",
        "key": "ctrl+k ctrl+alt+n",
        "when": "unrealSetup.projectActive && isWorkspaceTrusted"
      }
    ]
  },
  "scripts": {
    "test": "node ../tools/run-tests.cjs"
  },
  "extensionPack": [
    "ms-vscode.cpptools",
    "skyboxlabs.unrealengine-tools"
  ]
}
