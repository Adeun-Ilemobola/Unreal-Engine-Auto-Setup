{
  "name": "unreal-project-tools",
  "displayName": "Unreal Engine Auto Setup",
  "description": "Set up Unreal Engine projects, create C++ classes, modules and project plugins, build and open the Editor from VS Code.",
  "version": "0.6.5",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Extension Packs"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Writes project configuration and activates UnrealBuildTool integration only in trusted folders."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "unrealSetup.setup",
        "title": "Unreal: Set Up This Project"
      },
      {
        "command": "unrealSetup.build",
        "title": "Unreal: Build Project"
      },
      {
        "command": "unrealSetup.buildAndRun",
        "title": "Unreal: Build and Open Editor"
      },
      {
        "command": "unrealSetup.installExtensions",
        "title": "Unreal: Install Required Extensions"
      },
      {
        "command": "unrealSetup.openEditor",
        "title": "Unreal: Open Editor"
      },
      {
        "command": "unrealSetup.selectTarget",
        "title": "Unreal: Select Target"
      },
      {
        "command": "unrealSetup.selectPlatform",
        "title": "Unreal: Select Platform"
      },
      {
        "command": "unrealSetup.selectConfiguration",
        "title": "Unreal: Select Configuration"
      },
      {
        "command": "unrealSetup.selectBuild",
        "title": "Unreal: Select Build Settings"
      },
      {
        "command": "unrealSetup.diagnose",
        "title": "Unreal: Diagnose Project"
      },
      {
        "command": "unrealSetup.openLatestLog",
        "title": "Unreal: Open Latest Project Log"
      },
      {
        "command": "unrealSetup.attachDebugger",
        "title": "Unreal: Attach Debugger to Editor"
      },
      {
        "command": "unrealSetup.regenerate",
        "title": "Unreal: Regenerate Project Files"
      },
      {
        "command": "unrealSetup.newClass",
        "title": "Unreal: New C++ Class"
      },
      {
        "command": "unrealSetup.openModuleRules",
        "title": "Unreal: Open Module Build.cs"
      },
      {
        "command": "unrealSetup.openProjectDescriptor",
        "title": "Unreal: Open Project Descriptor"
      },
      {
        "command": "unrealSetup.openTargetRules",
        "title": "Unreal: Open Target Rules"
      },
      {
        "command": "unrealSetup.newModule",
        "title": "Unreal: New Module"
      },
      {
        "command": "unrealSetup.newPlugin",
        "title": "Unreal: New Plugin"
      },
      {
        "command": "unrealSetup.openPluginDescriptor",
        "title": "Unreal: Open Plugin Descriptor"
      },
      {
        "command": "unrealSetup.run",
        "title": "Unreal: Run"
      },
      {
        "command": "unrealSetup.refresh",
        "title": "Unreal: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "unrealSetup.createClassHere",
        "title": "Unreal: Create Class Here"
      }
    ],
    "configuration": {
      "title": "Unreal Engine Auto Setup",
      "properties": {
        "unrealSetup.autoSetup": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically initialize local Unreal project folders."
        },
        "unrealSetup.runtimeRefreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "description": "Lightweight runtime refresh interval in seconds: 0 disables polling; use 10–3600. Values between 0 and 10 fall back to 30. Does not build or regenerate."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unrealSetup",
          "title": "Unreal",
          "icon": "media/unreal.svg"
        }
      ]
    },
    "views": {
      "unrealSetup": [
        {
          "id": "unrealSetup.controlCenter",
          "name": "Unreal",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "unrealSetup.refresh",
          "when": "view == unrealSetup.controlCenter",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "unrealSetup.createClassHere",
          "when": "unrealSetup.projectActive && isWorkspaceTrusted && explorerResourceIsFolder && resourcePath in unrealSetup.classFolders",
          "group": "unreal@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "unrealSetup.newClass",
        "key": "ctrl+k ctrl+alt+n",
        "when": "unrealSetup.projectActive && isWorkspaceTrusted"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "extensionPack": [
    "ms-vscode.cpptools",
    "skyboxlabs.unrealengine-tools"
  ]
}
