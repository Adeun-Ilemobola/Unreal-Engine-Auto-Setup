+  } catch (err) {
+    result.error = err.message;
+    result.status = 'Failed';
+    if (result.exitCode === null) result.exitCode = -1;
+  } finally {
+    try {
+      await fs.writeFile(logFile, output);
+    } catch {}
+  }
+
+  return result;
