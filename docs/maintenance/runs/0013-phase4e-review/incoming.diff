+      try {
+        child = spawn(exe, args, { cwd, windowsHide: true, shell: isBatch });
+      } catch (err) {
+        return reject(err);
+      }
+      child.stdout?.on('data', b => {
+        output += b;
+        process.stdout.write(b);
+      });
